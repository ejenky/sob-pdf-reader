{
  "manifest_version": 3,
  "name": "Medicare SOB Extractor",
  "version": "1.2",
  "description": "Detects Medicare Summary of Benefits PDFs and extracts key plan data to clipboard",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Medicare SOB Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/pdf.min.js", "lib/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
